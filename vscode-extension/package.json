{
  "name": "svg-outline-tools",
  "displayName": "SVG Explorer Badge and Outline",
  "description": "Marks SVG files and provides an XML outline.",
  "version": "0.1.0",
  "publisher": "student-project",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished", "onLanguage:svg"],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [{ "id": "svg", "aliases": ["SVG"], "extensions": [".svg"] }]
  },
  "scripts": { "compile": "tsc -p ./", "watch": "tsc -watch -p ./" },
  "devDependencies": { "@types/vscode": "^1.85.0", "@types/node": "^20.0.0", "typescript": "^5.3.0" }
}
